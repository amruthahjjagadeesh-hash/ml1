# SkillVerse AI - Backend LLM Provider Configuration
# Copy this file to '.env' and fill in your preferred provider API key.
# Note: You only need ONE active provider.

# Option 1: Groq (Recommended - Fast, generous free tier)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Option 2: OpenAI (GPT-4o mini / GPT-4o)
# Get your key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Option 3: Google Gemini
# Get your key at: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# Option 4: Anthropic Claude
# Get your key at: https://console.anthropic.com/
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Option 5: Local Ollama / OpenAI-Compatible Endpoint
# LLM_API_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3
